# Copy this file to:  C:\Users\<you>\.sosimple-sync.env   (recommended – outside OneDrive, so the key is not shared)
#                 or:  .env in this sync folder
# and fill in the values. NEVER put this file in the website (my-app) folder – it contains a secret key.

# Supabase project URL (same as NEXT_PUBLIC_SUPABASE_URL in my-app/.env.local)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Option A (recommended): service role key
# Supabase dashboard > Project Settings > API > "service_role" secret
SUPABASE_SERVICE_ROLE_KEY=

# Option B: sign in as a normal portal user instead (leave the service key empty)
# SUPABASE_ANON_KEY=
# SYNC_EMAIL=
# SYNC_PASSWORD=

# Path to the workbook: relative to the sync folder, or a full path
DATA_FILE=../Data.xlsx

# Wait this many seconds after a save before syncing (Excel/OneDrive finish writing)
DEBOUNCE_SECONDS=5
# Also check the file this often, in case a save is missed
POLL_SECONDS=60
